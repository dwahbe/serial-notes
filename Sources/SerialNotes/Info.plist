<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.serialnotes.app</string>
    <key>CFBundleExecutable</key>
    <string>SerialNotes</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleName</key>
    <string>Serial Notes</string>
    <key>CFBundleDisplayName</key>
    <string>Serial Notes</string>
    <!-- App icon. AppIcon.icns lives next to this plist and is copied into
         Contents/Resources/ by build-app.sh; regenerate it from the brand
         mark with ./icon/make-icon.sh. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- Fallback version values. build-app.sh stamps the real version from
         the latest git tag (CFBundleShortVersionString) + commit count
         (CFBundleVersion) at wrap time; these defaults only apply to builds
         made outside a git checkout. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSUIElement</key>
    <true/>
    <!-- Custom URL scheme the Notion OAuth callback pages bounce into
         (serialnotes://oauth/notion?…). build-app.sh restamps the scheme to
         serialnotes-dev for ad-hoc dev builds so both flavors can complete
         OAuth side-by-side. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.serialnotes.app.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>serialnotes</string>
            </array>
        </dict>
    </array>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Serial Notes captures system audio to transcribe your meetings.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Serial Notes uses the microphone to record audio alongside system audio.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Serial Notes adds your finished meeting notes into Apple Notes.</string>
    <!-- Sparkle auto-update. SUFeedURL points at the site's counting proxy
         (site/src/pages/appcast.xml.ts), which serves a byte-faithful copy of
         the appcast committed to the repo (CI regenerates it on each tagged
         release) and tallies the daily check as an anonymous active-install
         count — day + version only, no identifiers. The site must be deployed
         before a release ships with this URL. SUPublicEDKey is the EdDSA
         public key; its private half lives in the keychain (and, for CI, a
         GitHub secret) and signs every update archive. -->
    <key>SUFeedURL</key>
    <string>https://serialnotes.app/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>I7y1j8aFLMstcce0vytj3gnUcd5UEKI/PPwX/UWjnWI=</string>
</dict>
</plist>
