# Server-side secrets for the on-demand routes (/admin, /appcast.xml,
# /oauth/notion/start, /api/notion/token). Copy to .env for local dev; set the
# same vars in Vercel → Settings → Environment Variables for production. The
# Supabase URL + publishable key are public by design and live in
# src/lib/analytics.ts, not here.

# Password for the /admin analytics dashboard.
ADMIN_PASSWORD=

# Supabase secret key for the "Serial Notes" project — used only to READ the
# appcast ping counts. Dashboard → Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=

# Optional: raises the GitHub API rate limit for release-download stats (the
# unauthenticated limit is shared across Vercel egress IPs). A fine-grained
# token with no scopes (public repo read) is enough.
# GITHUB_TOKEN=

# OAuth client for the "Serial Notes" public Notion connection (Notion →
# developer portal → the integration's Configuration tab). The app never sees
# these: /oauth/notion/start uses the ID to build the authorize URL, and
# /api/notion/token adds the Basic-auth secret Notion's token endpoints
# require (no PKCE). Tokens only transit those routes — never stored or logged.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
