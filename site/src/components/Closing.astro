---
import HalftoneLock from "./HalftoneLock.astro";

// The download + star call-to-action lives in `Cta.astro`, below the
// comparison table — this band is a calm "private by design" statement.
---

<!-- full-bleed: black background + inverted grid spill past the centered column -->
<section class="relative left-1/2 w-screen -translate-x-1/2 border-t border-line">
  <div class="relative overflow-hidden bg-ink text-white">
    <!-- faint inverted grid — drifts at ~0.75× scroll for subtle depth (see script below) -->
    <div
      id="closing-grid"
      class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:linear-gradient(to_right,#fff_1px,transparent_1px),linear-gradient(to_bottom,#fff_1px,transparent_1px)] [background-size:64px_64px] [background-position:50vw_-1px] [will-change:background-position]"
    >
    </div>
    <!-- clearing: dark wash behind the headline so the type sits in calm
         space (mirrors the hero — see .closing-clear in global.css) -->
    <div class="closing-clear pointer-events-none absolute inset-x-0 top-0 h-[480px] sm:h-[560px]"></div>

    <!-- left-to-right scrim (md+ only): fades the dots into the black so the
         headline stays crisp where text and lock sit side by side. Below md the
         lock stacks under the text instead, so no scrim is needed. -->
    <div
      class="pointer-events-none absolute inset-0 z-[1] hidden md:block [background:linear-gradient(to_right,var(--color-ink)_26%,transparent_70%)]"
    >
    </div>

    <!-- padlock. Below md it stacks ABOVE the text as a centered emblem so the
         copy always sits on solid black. From md up it moves into the right
         column and scales fluidly with the viewport (height = clamped vw, like
         fluid type), bleeding past the edges as it grows. The text column is a
         fixed 48% on the left and the lock is anchored at 52% — both are
         percentages of the same container, so the gap between them is constant
         at every width and they can never overlap. z-index (not DOM order)
         keeps the lock behind the scrim, both behind the text. It sits before
         the content in the DOM (for the mobile order); on desktop it's absolute
         so DOM order doesn't affect the overlay. -->
    <HalftoneLock
      class="relative z-0 mx-auto mt-12 block h-[220px] opacity-[0.85] md:absolute md:left-[52%] md:top-1/2 md:mx-0 md:my-0 md:h-[clamp(300px,48vw,600px)] md:-translate-y-1/2 lg:translate-y-[calc(-50%_+_38px)]"
    />

    <!-- content: left-aligned column, vertically centered against the lock.
         The wrapper is click-through (pointer-events-none) so the lock stays
         hoverable; only the text + link opt back in. -->
    <div
      class="pointer-events-none relative z-20 mx-auto flex max-w-6xl items-center px-5 py-16 text-left sm:px-8 md:min-h-[480px] md:py-24 lg:min-h-[560px] lg:py-28"
    >
      <div class="pointer-events-auto max-w-lg md:max-w-[48%]">
        <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-white/40">Private by design</p>

        <h2 class="tracking-tightest mt-3 text-balance text-4xl font-semibold leading-[1.05] lg:text-5xl">
          Your audio never leaves your Mac
        </h2>
        <p class="mt-6 text-pretty text-[17px] leading-relaxed text-white/65">
          Recording, transcription, and summaries all run on-device — nothing is
          ever uploaded. Each meeting saves as a plain Markdown file you own
          outright: a
          <a
            href="https://stephango.com/file-over-app"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-white underline decoration-white/30 underline-offset-[3px] transition-colors hover:decoration-white/70"
            >file over app</a
          > approach, so your notes stay readable in any editor long after Serial
          Notes is gone.
        </p>

        <p class="mt-7 text-[13.5px] font-medium text-white/45">
          No accounts · No servers · No telemetry
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initGridParallax } from "../scripts/gridParallax";
  const grid = document.getElementById("closing-grid");
  if (grid) initGridParallax(grid);
</script>
