---
import ComparisonTable from "./ComparisonTable.astro";

// "How it compares" — a hairline comparison table (Vercel-style) that sets
// Serial Notes against the closest cloud meeting-notes tools. The three
// headline differentiators (free, open source, on-device) lead the rows; the
// Serial Notes column is tinted to read as the recommended choice. The table
// itself (data + markup) lives in ComparisonTable.astro, shared with the
// deeper /compare page.
---

<section id="compare" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <!-- heading -->
    <div class="max-w-2xl">
      <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-faint">How it compares</p>
      <h2 class="tracking-tightest mt-3 text-balance text-3xl font-semibold leading-tight text-ink sm:text-4xl">
        Free, open source, and entirely on your Mac
      </h2>
      <p class="mt-4 max-w-lg text-pretty text-[17px] leading-relaxed text-muted">
        Most meeting tools are cloud subscriptions that need an account and a
        connection. Serial Notes is a free, open-source app that runs start to
        finish on your machine.
      </p>
    </div>

    <div class="mt-9 sm:mt-12">
      <ComparisonTable />
    </div>

    <p class="mt-6 text-[14px]">
      <a
        href="/compare/"
        class="font-medium text-muted underline decoration-line underline-offset-[3px] transition-colors hover:text-ink"
        >See the full comparison with Granola, Otter, and Fathom &rarr;</a
      >
    </p>
  </div>
</section>
