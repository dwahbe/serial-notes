---
// The comparison table itself — shared by the homepage "How it compares"
// section (Comparison.astro) and the /compare page, so the competitor facts
// live in exactly one place.
//
// Single source of truth for the data lives in `cols` + `rows` below — update
// a competitor fact in one place. Cell values:
//   true   → check (a capability the product has)
//   false  → muted dash (it doesn't)
//   string → rendered as text (a qualified answer, e.g. a price or "Partial")
//
// Competitor facts verified June 2026 from each product's own pricing/security
// pages plus independent reviews:
//   Granola   — Free up to 25 meetings, then ~$14+/user/mo; closed source;
//               records locally (no bot) but enhances notes via cloud AI
//               (OpenAI/Anthropic), so it needs a connection; account required.
//               https://www.granola.ai/pricing · https://www.granola.ai/security
//   Otter.ai  — Free 300 min/mo, then ~$8.33+/user/mo; closed source; cloud
//               transcription; Otter Assistant bot joins the call; account
//               required. https://otter.ai/pricing
//   Fathom    — Free unlimited recording but 5 AI summaries/mo, then ~$15+/mo;
//               closed source; cloud; bot joins the call by default; account
//               required. https://www.fathom.ai/pricing
// `mark` drives the column header logo. kind "serial" renders our inline
// waveform tile; kind "img" points at a brand mark in /public/logos. Per-mark
// heights optically balance the wide Otter wordmark-glyph against the squarer
// tiles. Granola is an official SVG (svgl); Otter + Fathom are their own
// high-res app-icon PNGs (they ship no icon-only SVG).
const cols = [
  { key: "serial", name: "Serial Notes", highlight: true, mark: { kind: "serial", src: "", h: 28, rounded: false } },
  { key: "granola", name: "Granola", highlight: false, mark: { kind: "img", src: "/logos/granola.svg", h: 24, rounded: false } },
  { key: "otter", name: "Otter.ai", highlight: false, mark: { kind: "img", src: "/logos/otter.png", h: 18, rounded: false } },
  { key: "fathom", name: "Fathom", highlight: false, mark: { kind: "img", src: "/logos/fathom.png", h: 26, rounded: true } },
] as const;

type Key = (typeof cols)[number]["key"];
type Cell = boolean | string;
type Row = { label: string; cells: Record<Key, Cell> };

const rows: Row[] = [
  {
    label: "Price",
    cells: {
      serial: "Free, unlimited",
      granola: "Free*, then $14/mo",
      otter: "Free*, then $8/mo",
      fathom: "Free*, then $15/mo",
    },
  },
  {
    label: "Open source",
    cells: { serial: true, granola: false, otter: false, fathom: false },
  },
  {
    label: "Runs fully on-device",
    cells: { serial: true, granola: "Partial", otter: false, fathom: false },
  },
  {
    label: "Works offline",
    cells: { serial: true, granola: false, otter: false, fathom: false },
  },
  {
    label: "No account required",
    cells: { serial: true, granola: false, otter: false, fathom: false },
  },
  {
    label: "No bot joins the call",
    cells: { serial: true, granola: true, otter: false, fathom: false },
  },
  {
    label: "Notes are plain local files",
    cells: { serial: true, granola: false, otter: false, fathom: false },
  },
];
---

<!-- table — scrolls horizontally on narrow screens with the feature
     column pinned (.cmp-rowhead) so the row labels stay readable.
     overscroll-x-none stops the elastic rubber-band from dragging the
     pinned column when you reverse scroll direction at the edge. -->
<div
  data-cmp-scroller
  class="overflow-x-auto overscroll-x-none [-ms-overflow-style:none] [scrollbar-width:thin]"
>
  <table class="w-full min-w-[500px] border-separate border-spacing-0 text-left sm:min-w-[660px]">
    <thead>
      <tr>
        <th class="cmp-rowhead w-[136px] px-3 py-4 sm:w-[30%] sm:px-4"></th>
        {
          cols.map((col) => (
            <th
              scope="col"
              class:list={[
                "relative px-3 pb-4 pt-5 text-center align-middle sm:px-4",
                col.highlight && "cmp-fav",
              ]}
            >
              {col.highlight && <span class="cmp-fav-accent" aria-hidden="true" />}
              <span class="flex flex-col items-center gap-2.5">
                <span class="flex h-8 items-center justify-center">
                  {col.mark.kind === "serial" ? (
                    <span
                      class="grid place-items-center rounded-[7px] bg-ink text-white shadow-sm"
                      style={`height:${col.mark.h}px;width:${col.mark.h}px`}
                    >
                      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.1" />
                        <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                          <line x1="4.6" y1="6" x2="4.6" y2="10" />
                          <line x1="6.3" y1="4.4" x2="6.3" y2="11.6" />
                          <line x1="8" y1="3.6" x2="8" y2="12.4" />
                          <line x1="9.7" y1="5" x2="9.7" y2="11" />
                          <line x1="11.4" y1="5.8" x2="11.4" y2="10.2" />
                        </g>
                      </svg>
                    </span>
                  ) : (
                    <img
                      src={col.mark.src}
                      alt=""
                      aria-hidden="true"
                      decoding="async"
                      loading="lazy"
                      style={`height:${col.mark.h}px`}
                      class:list={["w-auto", col.mark.rounded && "rounded-[6px]"]}
                    />
                  )}
                </span>
                <span
                  class:list={[
                    "text-[15px] font-semibold leading-none",
                    col.highlight ? "text-ink" : "text-muted",
                  ]}
                >
                  {col.name}
                </span>
              </span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th
              scope="row"
              class="cmp-rowhead cmp-cell px-3 py-4 text-[13.5px] font-medium leading-snug text-ink sm:px-4 sm:text-[15px]"
            >
              {row.label}
            </th>
            {
              cols.map((col) => {
                const v = row.cells[col.key];
                return (
                  <td
                    class:list={[
                      "cmp-cell px-3 py-4 text-center sm:px-4",
                      col.highlight && "cmp-fav",
                    ]}
                  >
                    {typeof v === "boolean" ? (
                      v ? (
                        <svg
                          width="19"
                          height="19"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class:list={[
                            "mx-auto",
                            col.highlight ? "text-ink" : "text-ink/55",
                          ]}
                          aria-label="Yes"
                          role="img"
                        >
                          <path d="M5 13l4 4L19 7" />
                        </svg>
                      ) : (
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          class="mx-auto text-[#cfcfcf]"
                          aria-label="No"
                          role="img"
                        >
                          <path d="M6 12h12" />
                        </svg>
                      )
                    ) : (
                      <span
                        class:list={[
                          "text-[13.5px] leading-snug",
                          col.highlight ? "font-medium text-ink" : "text-muted",
                        ]}
                      >
                        {v}
                      </span>
                    )}
                  </td>
                );
              })
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="mt-5 max-w-3xl text-[12.5px] leading-relaxed text-faint">
  <span class="font-mono">*</span> Free tiers are capped — Granola 25 meetings
  total, Otter 300 minutes/month, Fathom 5 AI summaries/month. Granola records
  locally but enhances notes with cloud AI, so it needs a connection. Otter and
  Fathom now offer bot-free capture modes but default to a bot that joins the
  call. Details verified June 2026; see each product&rsquo;s pricing page.
</p>

<style>
  /* Row separators via top borders on each cell (border-separate keeps the
     sticky first column's edges crisp where border-collapse would drop them). */
  .cmp-cell {
    border-top: 1px solid var(--color-line);
  }

  /* Pin the feature-label column while the competitor columns scroll.
     z-index keeps it above the scrolling competitor cells. */
  .cmp-rowhead {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--color-paper);
  }

  /* Once the competitor columns have scrolled at all, a soft right-edge shadow
     signals that the label column is frozen (and hides any sub-pixel bleed of
     scrolling content past its edge). Toggled by the scroll listener below. */
  [data-cmp-scroller][data-scrolled="true"] .cmp-rowhead {
    box-shadow: 8px 0 8px -8px rgba(0, 0, 0, 0.18);
    clip-path: inset(0 -16px 0 0);
  }

  /* The recommended column: a soft tint band the full height of the table. */
  .cmp-fav {
    background: var(--color-line-soft);
  }
  thead .cmp-fav {
    position: relative;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
  }
  tbody tr:last-child .cmp-fav {
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
  }
  /* 2px ink accent across the top of the favored header. */
  .cmp-fav-accent {
    position: absolute;
    top: 0;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-ink);
  }
</style>

<script>
  // Flag the scroller once the competitor columns have been scrolled, so the
  // frozen label column gets a soft right-edge shadow (see [data-scrolled] CSS).
  for (const scroller of document.querySelectorAll<HTMLElement>("[data-cmp-scroller]")) {
    const sync = () => {
      const next = scroller.scrollLeft > 0 ? "true" : "false";
      if (scroller.dataset.scrolled !== next) scroller.dataset.scrolled = next;
    };
    scroller.addEventListener("scroll", sync, { passive: true });
    sync();
  }
</script>
