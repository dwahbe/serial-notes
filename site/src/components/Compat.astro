---
// "Fully compatible with" trust strip — the apps that read the plain-Markdown
// export, shown as official brand marks in full brand color. The ".md works
// anywhere" point is carried by the trailing "+ anything that reads .md" line
// rather than a dedicated Markdown mark. Per-icon heights optically balance the
// silhouette marks (Notion, Obsidian, Bear) against the filled app-icon tiles
// (Apple Notes, Logseq). Logos live in /public/logos.
// `h` is the mobile height; `hLg` scales each mark up ~1.4x on desktop (sm and
// above), where the strip has more room to breathe. `soon: true` marks an app
// not yet supported (Notion, kept last): the (decorative, aria-hidden) logo is
// dimmed and the name gets a small inline "Coming soon" pill. The pill is
// inline (inside the name span, not a flex sibling or a floating absolute
// badge) so it reads as one phrase bound to the app and can't detach from it or
// overlap the wrapped "+ anything" line on mobile. Only the logo is dimmed —
// not the name or pill — so both keep AA contrast (a 50%-opacity name or pill
// composites to ~2:1 on white, which fails); the pill's text-muted on bg-line
// is ~5.4:1.
const apps = [
  { name: "Apple Notes", file: "apple-notes", h: 30, hLg: 42 },
  { name: "Obsidian", file: "obsidian", h: 32, hLg: 45 },
  { name: "Bear", file: "bear", h: 31, hLg: 43 },
  { name: "Logseq", file: "logseq", h: 30, hLg: 42 },
  { name: "Notion", file: "notion", h: 27, hLg: 38, soon: true },
];
---

<section class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-14">
    <p class="text-center font-mono text-[12px] uppercase tracking-[0.18em] text-faint">
      Fully compatible with
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-9 gap-y-6 sm:gap-x-12">
      {
        apps.map(({ name, file, h, hLg, soon }) => (
          <div class="group flex items-center gap-2.5">
            <img
              src={`/logos/${file}.svg`}
              alt=""
              aria-hidden="true"
              decoding="async"
              style={`--h:${h}px;--h-lg:${hLg}px`}
              class={`logo-mark w-auto ${soon ? "opacity-50" : ""}`}
            />
            <span class="text-[15px] font-medium text-faint transition-colors group-hover:text-ink">
              {name}
              {soon && (
                <span class="ml-2 inline-block whitespace-nowrap rounded-full bg-line px-2.5 py-[3px] align-[1px] text-[11px] font-semibold uppercase tracking-wide text-muted">
                  Coming soon
                </span>
              )}
            </span>
          </div>
        ))
      }

      <span class="text-[15px] font-medium text-faint">+ anything that reads <span class="font-mono">.md</span></span>
    </div>
  </div>
</section>

<style>
  .logo-mark {
    height: var(--h);
  }
  /* Tailwind's `sm` breakpoint — match the section's existing scale-up point. */
  @media (min-width: 640px) {
    .logo-mark {
      height: var(--h-lg);
    }
  }
</style>
