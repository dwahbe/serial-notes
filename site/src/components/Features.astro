---
// "How it works" — a scroll-driven stepper (Dia-style). On desktop the two-column
// panel pins for the section's whole scroll: the step list stays put while the
// active step's focus + description and the matching Mac "stage" visual change as
// you scroll (detect → record → summarize → export). The list never travels up
// the page — only the focus moves between titles, Dia-style.
// Scroll-driven on desktop; auto-cycles on mobile; static under reduced motion.
const steps = [
  {
    n: "01",
    title: "Captures every meeting",
    body: "Serial Notes watches for Zoom, Teams, FaceTime, Slack and more. The moment a call starts, a notification offers one-click recording — and it stops itself when the call ends.",
  },
  {
    n: "02",
    title: "Transcribes on your Mac",
    body: "Audio is transcribed on-device with automatic speaker labels. Nothing leaves your Mac, and after a one-time setup it works fully offline.",
  },
  {
    n: "03",
    title: "Summaries &amp; action items",
    body: "When the meeting wraps, Apple Intelligence drafts a tight summary and a checklist of to-dos — generated right on your machine.",
  },
  {
    n: "04",
    title: "Exports clean Markdown",
    body: 'Every meeting saves itself as one tidy <span class="font-mono text-[13.5px]">.md</span> file in the folder you choose — open it in Notion, Obsidian, or Apple Notes, anywhere plain text goes.',
  },
];
---

<section id="features" data-howitworks class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-10 sm:px-8 sm:pt-20 sm:pb-10">
    <!-- heading -->
    <div class="max-w-2xl">
      <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-faint">How it works</p>
      <h2 class="tracking-tightest mt-3 text-balance text-3xl font-semibold leading-tight text-ink sm:text-4xl">
        From call to clean notes,<br />all on device
      </h2>
      <p class="mt-4 max-w-lg text-pretty text-[17px] leading-relaxed text-muted">
        Serial Notes runs entirely from your menu bar and handles the whole
        loop — watch it work, start to finish.
      </p>
    </div>

    <!-- Scroll track (desktop): the panel inside pins for the track's whole
         height, so the step list stays in place while scroll only moves the
         focus + active visual. On mobile the track collapses to a normal block
         (swipeable carousel above, stage below). -->
    <div data-track class="mt-10 desk:mt-0 desk:h-[360vh]">
      <div
        class="mx-auto flex max-w-3xl flex-col desk:sticky desk:top-0 desk:grid desk:h-screen desk:max-w-none desk:grid-cols-[1fr_1.05fr] desk:content-center desk:items-start desk:gap-12 xl:desk:gap-16"
      >
        <!-- ── STAGE — the visual: on top on mobile, right column on lg ── -->
        <div class="relative order-1 desk:order-2 desk:mt-0">
          <div
            data-stage
            class="relative h-[400px] overflow-hidden rounded-2xl border border-line bg-gradient-to-br from-[#f7f7f8] to-[#e9e9eb] shadow-[0_24px_70px_-24px_rgba(0,0,0,0.22)] sm:h-[460px] desk:h-[calc(100vh_-_clamp(280px,28vh,440px))]"
          >
            <!-- soft wallpaper sheen -->
            <div
              class="pointer-events-none absolute -inset-px bg-[radial-gradient(120%_80%_at_80%_-10%,rgba(255,255,255,0.9),transparent_60%)]"
            >
            </div>

            <!-- menu bar -->
            <div
              class="absolute inset-x-0 top-0 z-30 flex h-7 items-center justify-end gap-3.5 border-b border-black/[0.06] bg-white/55 px-3 text-ink/70 backdrop-blur-md"
            >
              <span data-mbicon class="relative grid h-[19px] w-[19px] place-items-center rounded-[5px] bg-black/[0.08] text-ink">
                <!-- Canonical brand mark (site/public/favicon.svg) — ring + the
                     6-bar waveform; keep these coords in lockstep with it. -->
                <svg width="15" height="15" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2"></circle>
                  <g class="wf-bars" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <line x1="9.5" y1="13.75" x2="9.5" y2="18.25"></line>
                    <line x1="12.1" y1="12" x2="12.1" y2="20"></line>
                    <line x1="14.7" y1="10.75" x2="14.7" y2="21.25"></line>
                    <line x1="17.3" y1="13.5" x2="17.3" y2="18.5"></line>
                    <line x1="19.9" y1="12" x2="19.9" y2="20"></line>
                    <line x1="22.5" y1="14.5" x2="22.5" y2="17.5"></line>
                  </g>
                </svg>
                <span class="rec-dot absolute -right-1 -top-1 h-2 w-2 rounded-full bg-red-500 opacity-0 ring-2 ring-white"></span>
              </span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h.01"></path>
                <path d="M2 8.82a15 15 0 0 1 20 0"></path>
                <path d="M5 12.86a10 10 0 0 1 14 0"></path>
                <path d="M8.5 16.43a5 5 0 0 1 7 0"></path>
              </svg>
              <svg width="22" height="14" viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="1" y="1.5" width="20" height="11" rx="3"></rect>
                <rect x="3" y="3.5" width="13" height="7" rx="1.5" fill="currentColor" stroke="none"></rect>
                <path d="M24 5v4" stroke-linecap="round"></path>
              </svg>
              <span class="font-medium tabular-nums text-[12.5px] tracking-tight">10:09</span>
            </div>

            <!-- ░░ VISUAL 0 — detection banner ░░ -->
            <div data-vis="0" class="vis absolute inset-0">
              <div class="absolute right-4 top-9 w-[290px] sm:w-[300px]">
                <div class="flex items-center gap-2.5 rounded-[18px] border border-black/[0.08] bg-white pl-3 shadow-[0_18px_45px_-12px_rgba(0,0,0,0.32)]">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-white">
                    <!-- Canonical filled brand mark (BrandFilledMark): the span
                         is the black disc; the 6 white waveform bars are drawn in
                         the favicon's 32-space, cropped to the disc (viewBox 3 3
                         26 26 = the r=13 disc), so the bars fill ~50% like the app. -->
                    <svg width="36" height="36" viewBox="3 3 26 26" fill="none" aria-hidden="true">
                      <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                        <line x1="9.5" y1="13.75" x2="9.5" y2="18.25"></line>
                        <line x1="12.1" y1="12" x2="12.1" y2="20"></line>
                        <line x1="14.7" y1="10.75" x2="14.7" y2="21.25"></line>
                        <line x1="17.3" y1="13.5" x2="17.3" y2="18.5"></line>
                        <line x1="19.9" y1="12" x2="19.9" y2="20"></line>
                        <line x1="22.5" y1="14.5" x2="22.5" y2="17.5"></line>
                      </g>
                    </svg>
                  </span>
                  <div class="py-3">
                    <p class="text-[13px] font-semibold leading-tight text-ink">Meeting detected</p>
                    <p class="text-[12px] leading-tight text-ink/55">Zoom</p>
                  </div>
                  <span class="ml-auto py-1.5 pr-1.5">
                    <span class="flex items-center gap-1.5 rounded-full bg-ink px-3 py-[7px] text-[12.5px] font-semibold text-white">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.2"></circle>
                        <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
                      </svg>
                      Record
                    </span>
                  </span>
                </div>
              </div>
            </div>

            <!-- ░░ VISUAL 1 — recording popover ░░ -->
            <div data-vis="1" class="vis absolute inset-0">
              <div class="absolute right-4 top-9 w-[260px] sm:w-[280px]">
                <div class="overflow-hidden rounded-2xl border border-black/[0.07] bg-white/95 p-5 shadow-[0_22px_55px_-14px_rgba(0,0,0,0.3)] backdrop-blur-xl">
                  <div class="flex items-center justify-center gap-2.5">
                    <span class="relative flex h-2.5 w-2.5">
                      <span class="rec-ping absolute inline-flex h-full w-full rounded-full bg-red-500/70"></span>
                      <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-red-500"></span>
                    </span>
                    <span class="text-[15px] font-semibold tracking-tight text-ink">Recording</span>
                  </div>
                  <div data-timer class="mt-3 text-center font-mono text-[34px] font-medium tabular-nums tracking-tight text-ink">
                    00:00
                  </div>
                  <div class="mt-4 flex w-full items-center justify-center gap-2 rounded-[10px] bg-ink py-2.5 text-[13.5px] font-medium text-white">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle>
                      <rect x="8.5" y="8.5" width="7" height="7" rx="1.5" fill="currentColor"></rect>
                    </svg>
                    Stop Recording
                  </div>
                </div>
              </div>
            </div>

            <!-- ░░ VISUAL 2 — summary + action items ░░ -->
            <div data-vis="2" class="vis absolute inset-0">
              <div class="absolute inset-x-0 top-9 grid place-items-center px-6 desk:inset-y-0">
                <div class="w-full max-w-[370px] rounded-xl border border-line bg-white p-5 shadow-[0_18px_50px_-16px_rgba(0,0,0,0.28)]">
                  <div class="flex items-center gap-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-ink" aria-hidden="true">
                      <path d="M9.94 14.06 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5l1.44 1.44 6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06l-1.44 1.44-1.58 6.14a.5.5 0 0 1-.96 0z"></path>
                    </svg>
                    <span class="text-[13px] font-semibold text-ink">Summary</span>
                    <span class="ml-auto rounded-full bg-line-soft px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-faint">Apple Intelligence</span>
                  </div>
                  <p class="mt-2 text-[12.5px] leading-relaxed text-muted">
                    Team aligned on the Q3 launch. The auth migration is the last
                    blocker; design sign-off lands Thursday.
                  </p>
                  <div class="mt-4 flex items-center gap-2">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-ink" aria-hidden="true">
                      <path d="m3 17 2 2 4-4"></path>
                      <path d="m3 7 2 2 4-4"></path>
                      <path d="M13 6h8M13 12h8M13 18h8"></path>
                    </svg>
                    <span class="text-[13px] font-semibold text-ink">Action items</span>
                  </div>
                  <ul class="mt-2.5 space-y-2 text-[12.5px] text-muted">
                    <li class="flex items-center gap-2">
                      <span class="grid h-[15px] w-[15px] shrink-0 place-items-center rounded-[4px] border border-line"></span>
                      Dylan — ship the auth migration PR
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="grid h-[15px] w-[15px] shrink-0 place-items-center rounded-[4px] border border-line"></span>
                      Priya — finalize onboarding copy
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="grid h-[15px] w-[15px] shrink-0 place-items-center rounded-[4px] bg-ink text-white">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                      </span>
                      <span class="text-faint line-through">Sam — book the launch review</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- ░░ VISUAL 3 — clean Markdown file ░░ -->
            <div data-vis="3" class="vis absolute inset-0">
              <div class="absolute inset-x-0 top-9 grid place-items-center px-6 desk:inset-y-0">
                <div class="w-full max-w-[400px] overflow-hidden rounded-xl border border-line bg-paper shadow-[0_18px_50px_-16px_rgba(0,0,0,0.28)]">
                  <div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-[#e5e5e5]"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-[#e5e5e5]"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-[#e5e5e5]"></span>
                    <span class="ml-2 font-mono text-[11px] text-faint">weekly-standup.md</span>
                  </div>
                  <div class="relative px-5 py-4 font-mono text-[12px] leading-[1.8]">
                    <p><span class="text-faint">#</span> <span class="font-semibold text-ink">Weekly Standup</span></p>
                    <p class="text-faint">June 1, 2026 · 6 participants</p>
                    <p class="mt-3"><span class="text-faint">##</span> <span class="font-semibold text-ink">Summary</span></p>
                    <p class="text-muted">Team aligned on the Q3 launch. Auth migration is the last blocker.</p>
                    <p class="mt-3"><span class="text-faint">##</span> <span class="font-semibold text-ink">Action items</span></p>
                    <p class="text-muted"><span class="text-faint">- [ ]</span> Dylan — ship the auth migration PR</p>
                    <p class="text-muted"><span class="text-faint">- [x]</span> <span class="line-through decoration-faint">Sam — book the launch review</span></p>
                    <p class="mt-3"><span class="text-faint">##</span> <span class="font-semibold text-ink">Transcript</span></p>
                    <p><span class="font-semibold text-ink">You</span> <span class="text-faint">09:02</span> Let's start with the blockers.</p>
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-paper to-transparent"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ── STEPS — pinned focus list on lg; on mobile the active step is
             shown as a caption under the stage instead (see [data-cap]). ── -->
        <ol
          data-steps
          class="hidden desk:order-1 desk:block desk:space-y-6"
        >
          {
            steps.map((step, i) => (
              <li>
                <button
                  data-step
                  type="button"
                  class="step group relative flex h-full w-full cursor-pointer flex-col rounded-xl border border-line p-5 text-left desk:rounded-none desk:border-0 desk:py-4 desk:pl-7 desk:pr-0"
                >
                  <div class="bar-track relative h-[2px] w-full overflow-hidden rounded-full bg-line">
                    <span data-bar class="absolute inset-y-0 left-0 w-full bg-ink" />
                  </div>
                  <div class="mt-4 flex flex-col gap-1.5 desk:mt-0">
                    <span data-num class="font-mono text-[12px] uppercase tracking-[0.18em] text-faint transition-colors">{step.n}</span>
                    <span
                      data-title
                      class="text-xl font-semibold tracking-tight text-ink transition-colors desk:text-2xl desk:text-muted"
                      set:html={step.title}
                    />
                  </div>
                  <div class="desc-wrap">
                    <div>
                      <p class="pt-3 max-w-md text-[15px] leading-relaxed text-muted" set:html={step.body} />
                    </div>
                  </div>
                </button>
              </li>
            ))
          }
        </ol>

        <!-- Active-step caption (mobile only) — Apple-style: bold lead-in, muted
             body. All captions share one grid cell so the block is always as
             tall as the longest one — the arrows below stay put as you step,
             and the active caption cross-fades like the stage. -->
        <div class="order-2 mt-6 grid desk:hidden">
          {
            steps.map((step, i) => (
              <p
                data-cap
                class={`cap [grid-area:1/1] text-pretty text-[15px] leading-relaxed text-muted${i === 0 ? " is-active" : ""}`}
              >
                <strong class="font-semibold text-ink" set:html={step.title} />. <span set:html={step.body} />
              </p>
            ))
          }
        </div>

        <!-- Carousel nav (mobile only) — steps one at a time, disabled at the
             ends, like Apple's product carousels. -->
        <div class="order-3 mt-4 flex items-center justify-end gap-2.5 desk:hidden">
          <button
            data-prev
            type="button"
            aria-label="Previous step"
            class="grid h-10 w-10 place-items-center rounded-full bg-black/[0.06] text-ink/75 transition enabled:hover:bg-black/[0.1] enabled:active:scale-95 disabled:opacity-30"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button
            data-next
            type="button"
            aria-label="Next step"
            class="grid h-10 w-10 place-items-center rounded-full bg-black/[0.06] text-ink/75 transition enabled:hover:bg-black/[0.1] enabled:active:scale-95 disabled:opacity-30"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vis {
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  .vis.is-active {
    opacity: 1;
  }

  /* Mobile caption layers — cross-fade in step with the stage above them. */
  .cap {
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .cap.is-active {
    opacity: 1;
  }

  [data-howitworks].is-recording .rec-dot {
    opacity: 1;
  }
  .rec-ping {
    animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%, 100% { transform: scale(2.2); opacity: 0; }
  }
  .wf-bars line {
    transform-box: fill-box;
    transform-origin: center;
  }
  [data-howitworks].is-recording .wf-bars line {
    animation: wf 0.9s ease-in-out infinite;
  }
  .wf-bars line:nth-child(1) { animation-delay: 0s; }
  .wf-bars line:nth-child(2) { animation-delay: 0.15s; }
  .wf-bars line:nth-child(3) { animation-delay: 0.3s; }
  .wf-bars line:nth-child(4) { animation-delay: 0.1s; }
  .wf-bars line:nth-child(5) { animation-delay: 0.22s; }
  .wf-bars line:nth-child(6) { animation-delay: 0.32s; }
  @keyframes wf {
    0%, 100% { transform: scaleY(0.55); }
    50% { transform: scaleY(1); }
  }

  /* Pinned desktop (wide AND tall — matches the `desk` variant): collapse each
     step's description unless active, dim inactive titles, and turn the progress
     bar into a left rail. */
  @media (min-width: 1024px) and (min-height: 700px) {
    .desc-wrap {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition: grid-template-rows 0.35s ease, opacity 0.35s ease;
    }
    .desc-wrap > div {
      overflow: hidden;
    }
    .step.is-active .desc-wrap {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .step.is-active [data-num],
    .step.is-active [data-title] {
      color: var(--color-ink);
    }
    .bar-track {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 2px;
      background: transparent; /* no rail on the inactive steps */
    }
    [data-bar] {
      inset: 0;
      width: 100%;
      height: 100%;
      transform: scaleY(0);
      transform-origin: top center;
      transition: transform 0.3s ease;
    }
    /* Only the focused step shows its vertical accent bar (Dia-style). */
    .step.is-active [data-bar] {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-howitworks] *,
    [data-howitworks] *::before,
    [data-howitworks] *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-howitworks]");
  if (section) {
    const stage = section.querySelector<HTMLElement>("[data-stage]")!;
    const steps = Array.from(section.querySelectorAll<HTMLElement>("[data-step]"));
    const vis = Array.from(stage.querySelectorAll<HTMLElement>(".vis"));
    const timerEl = stage.querySelector<HTMLElement>("[data-timer]")!;
    const N = steps.length;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const desktopMq = window.matchMedia("(min-width: 1024px) and (min-height: 700px)");
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const caps = Array.from(section.querySelectorAll<HTMLElement>("[data-cap]"));
    const prevBtn = section.querySelector<HTMLButtonElement>("[data-prev]");
    const nextBtn = section.querySelector<HTMLButtonElement>("[data-next]");

    let active = -1;
    let recTimer: ReturnType<typeof setInterval> | null = null;

    function startRecTimer() {
      if (recTimer) return;
      let s = 0;
      timerEl.textContent = "00:00";
      recTimer = setInterval(() => {
        s = (s + 1) % 60;
        timerEl.textContent = "00:" + String(s).padStart(2, "0");
      }, 1000);
    }
    function stopRecTimer() {
      if (recTimer) clearInterval(recTimer);
      recTimer = null;
    }

    function setActive(i: number) {
      if (i === active) return;
      active = i;
      steps.forEach((s, idx) => s.classList.toggle("is-active", idx === i));
      vis.forEach((v, idx) => v.classList.toggle("is-active", idx === i));
      caps.forEach((c, idx) => c.classList.toggle("is-active", idx === i));
      stage.classList.toggle("is-recording", i === 1);
      if (i === 1) startRecTimer();
      else stopRecTimer();
      if (prevBtn) prevBtn.disabled = i <= 0;
      if (nextBtn) nextBtn.disabled = i >= N - 1;
    }

    // Mode is chosen per-mount and re-chosen when crossing the lg breakpoint,
    // so a desktop→narrow resize (or a preview that loads wide) still works.
    //
    // Desktop: the [data-track] wrapper is tall and its inner panel is pinned
    // (position: sticky). Scroll progress through the track (0→1) maps onto the
    // N steps, so the list stays put while only the focus + active visual move.
    function mountDesktop(): () => void {
      const trackEl = section!.querySelector<HTMLElement>("[data-track]")!;
      let ticking = false;
      let frame = 0;
      // While a click-to-jump smooth-scroll is in flight, hold the destination
      // open and skip the steps we scroll past, so 1→4 doesn't flash 2 and 3.
      // Cleared on arrival, or if the user grabs the scroll themselves.
      let jumpingTo = -1;
      const idxFromScroll = () => {
        const scrollable = trackEl.offsetHeight - window.innerHeight;
        if (scrollable <= 0) return 0;
        const scrolled = clamp(-trackEl.getBoundingClientRect().top, 0, scrollable);
        return clamp(Math.floor((scrolled / scrollable) * N), 0, N - 1);
      };
      const update = () => {
        ticking = false;
        const idx = idxFromScroll();
        if (jumpingTo >= 0) {
          if (idx === jumpingTo) jumpingTo = -1; // arrived — resume tracking
          else return; // in transit — keep the destination open, skip the rest
        }
        setActive(idx);
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        frame = requestAnimationFrame(update);
      };
      const cancelJump = () => (jumpingTo = -1);
      // Click a step → open it now and smooth-scroll its segment into view,
      // without activating (flashing) the steps in between.
      const onClick = (e: Event) => {
        const i = steps.indexOf(e.currentTarget as HTMLElement);
        const scrollable = Math.max(0, trackEl.offsetHeight - window.innerHeight);
        const targetP = N > 1 ? (i + 0.5) / N : 0;
        const top = window.scrollY + trackEl.getBoundingClientRect().top + targetP * scrollable;
        jumpingTo = i;
        setActive(i);
        window.scrollTo({ top, behavior: reduce ? "auto" : "smooth" });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      // A manual scroll mid-jump takes over: stop suppressing intermediates.
      // For keydown, only scroll-driving keys count — a Tab/letter shouldn't
      // cancel the jump and flash the steps in between.
      const scrollKeys = new Set([" ", "Spacebar", "PageUp", "PageDown", "Home", "End", "ArrowUp", "ArrowDown"]);
      const onKey = (e: KeyboardEvent) => {
        if (scrollKeys.has(e.key)) cancelJump();
      };
      window.addEventListener("wheel", cancelJump, { passive: true });
      window.addEventListener("touchstart", cancelJump, { passive: true });
      window.addEventListener("keydown", onKey);
      steps.forEach((s) => s.addEventListener("click", onClick));
      update();
      return () => {
        cancelAnimationFrame(frame);
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        window.removeEventListener("wheel", cancelJump);
        window.removeEventListener("touchstart", cancelJump);
        window.removeEventListener("keydown", onKey);
        steps.forEach((s) => s.removeEventListener("click", onClick));
      };
    }

    // Mobile: no carousel — the stage + a single caption show the active step,
    // and the arrows step through it (disabled at the ends). Auto-play walks the
    // flow once when the section scrolls into view, then stops (so it doesn't
    // fight the arrows' end-stops).
    function mountMobile(): () => void {
      setActive(active < 0 ? 0 : active);
      let auto: ReturnType<typeof setInterval> | null = null;
      let engaged = false;
      let inView = false;
      const stopAuto = () => {
        if (auto) clearInterval(auto);
        auto = null;
      };
      const advance = () => {
        if (active >= N - 1) return stopAuto(); // reached the end — stop
        setActive(active + 1);
      };
      const startAuto = () => {
        if (auto || engaged || reduce || document.hidden || !inView || active >= N - 1) return;
        auto = setInterval(advance, 4200);
      };
      const disengage = () => {
        engaged = true;
        stopAuto();
      };
      // Arrows step one at a time; clamp() handles the ends (the buttons are also
      // disabled there), and any use stops the auto-play.
      const go = (delta: number) => {
        disengage();
        setActive(clamp(active + delta, 0, N - 1));
      };
      const onPrev = () => go(-1);
      const onNext = () => go(1);
      const onVis = () => (document.hidden ? stopAuto() : startAuto());
      // Swipe the stage — left = next, right = prev (alongside the arrows).
      // Passive + threshold-gated on a clearly horizontal gesture, so taps and
      // vertical page scrolling are left alone.
      let sx = 0;
      let sy = 0;
      const onTouchStart = (e: TouchEvent) => {
        const t = e.changedTouches[0];
        sx = t.clientX;
        sy = t.clientY;
      };
      const onTouchEnd = (e: TouchEvent) => {
        const t = e.changedTouches[0];
        const dx = t.clientX - sx;
        const dy = t.clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) go(dx < 0 ? 1 : -1);
      };
      prevBtn?.addEventListener("click", onPrev);
      nextBtn?.addEventListener("click", onNext);
      stage.addEventListener("touchstart", onTouchStart, { passive: true });
      stage.addEventListener("touchend", onTouchEnd, { passive: true });
      document.addEventListener("visibilitychange", onVis);
      // Only auto-play while the section is actually on screen.
      const io = new IntersectionObserver(
        (entries) => {
          inView = entries[0].isIntersecting;
          if (inView) startAuto();
          else stopAuto();
        },
        { threshold: 0.4 }
      );
      io.observe(stage);
      return () => {
        io.disconnect();
        prevBtn?.removeEventListener("click", onPrev);
        nextBtn?.removeEventListener("click", onNext);
        stage.removeEventListener("touchstart", onTouchStart);
        stage.removeEventListener("touchend", onTouchEnd);
        document.removeEventListener("visibilitychange", onVis);
        stopAuto();
      };
    }

    let teardown = (desktopMq.matches ? mountDesktop : mountMobile)();
    desktopMq.addEventListener("change", (e) => {
      teardown();
      active = -1;
      teardown = (e.matches ? mountDesktop : mountMobile)();
    });
  }
</script>
