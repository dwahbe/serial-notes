---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Compat from "../components/Compat.astro";
import Features from "../components/Features.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />

  <!-- Centered, hairline-framed content column (the technical-drawing look).
       Borders paint INSIDE the box, so a left+right border lands its lines at
       x=144 and x=1295 (1151px apart) — but the backdrop grid lines fall on the
       box EDGES (144 and 1296, 1152px apart). The left coincides; the right was
       1px short, doubling against the grid line. Fix: keep the real left border
       (on the grid line at 144) and draw the right line as a 1px OUTSET shadow
       on the box edge (1296), so it sits exactly on the grid line. -->
  <main class="relative mx-auto max-w-6xl border-l border-line [box-shadow:1px_0_0_0_var(--color-line)]">
    <!-- crosses offset -1px so each stroke sits on the frame line: the left
         border paints at x=144, the right shadow at x=1296 (both grid lines) -->
    <span class="cross -left-px top-0"></span>
    <span class="cross -right-px top-0"></span>
    <span class="cross bottom-0 -left-px"></span>
    <span class="cross bottom-0 -right-px"></span>

    <Hero />
    <Compat />
    <Features />
    <Closing />
  </main>

  <Footer />
</Layout>
