---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Compat from "../components/Compat.astro";
import Features from "../components/Features.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />

  <!-- Centered, hairline-framed content column (the technical-drawing look).
       Both side lines are box-shadows, not borders, so neither steals a pixel of
       content width. A real `border-l` does: it shrinks the content box on the
       left only, pushing its center 0.5px right of the viewport center — and the
       full-bleed sections (Hero, Closing) center on this box, so that 0.5px left
       a sub-pixel white sliver down the left edge of the black Closing band.
       Inset-left + outset-right keeps the content box symmetric and viewport-
       centered, so the bleeds reach x=0 exactly. The lines still land on the
       backdrop grid: the inset-left paints the box's inner edge from x=144, the
       outset-right sits on the box edge at x=1296. -->
  <main class="relative mx-auto max-w-6xl [box-shadow:inset_1px_0_0_0_var(--color-line),1px_0_0_0_var(--color-line)]">
    <!-- crosses sit on the frame lines (both grid lines): the left stroke at
         x=144 (left-0, on the box edge), the right at x=1296 (-right-px, on the
         outset shadow) -->
    <span class="cross left-0 top-0"></span>
    <span class="cross -right-px top-0"></span>
    <span class="cross bottom-0 left-0"></span>
    <span class="cross bottom-0 -right-px"></span>

    <Hero />
    <Compat />
    <Features />
    <Closing />
  </main>

  <Footer />
</Layout>
